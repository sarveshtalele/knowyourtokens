{
  "name": "knowyourtokens-client",
  "version": "2.3.0",
  "description": "TypeScript/JavaScript client for the Know Your Tokens local API (token, tool, skill and MCP observability for AI coding agents)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "llm",
    "telemetry",
    "tokens",
    "observability",
    "mcp",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarveshtalele/knowyourtokens.git",
    "directory": "sdk/js"
  },
  "homepage": "https://sarveshtalele.github.io/knowyourtokens/",
  "license": "MIT",
  "author": "Sarvesh Talele",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
